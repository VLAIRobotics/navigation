Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Height-colored PCD Ground1
        - /Static PCD Structures1
        - /Current Navigation Obstacles1
        - /全局膨胀代价1
        - /局部膨胀代价1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
  - Class: bringup/NavigationStatus
    Name: 导航诊断
Visualization Manager:
  Class: ""
  Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Alpha: 1
      Axes Length: 0.8
      Axes Radius: 0.05
      Class: rviz_default_plugins/Pose
      Color: 255; 50; 50
      Enabled: true
      Head Length: 0.25
      Head Radius: 0.08
      Name: Localization Preview
      Shaft Length: 0.6
      Shaft Radius: 0.04
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /small_gicp/pose
      Value: true
    - Alpha: 0.9
      Axes Length: 0.6
      Axes Radius: 0.035
      Class: rviz_default_plugins/Pose
      Color: 255; 170; 30
      Enabled: true
      Head Length: 0.22
      Head Radius: 0.07
      Name: Unverified GICP Candidate
      Shaft Length: 0.5
      Shaft Radius: 0.035
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /small_gicp/candidate_pose
      Value: true
    - Alpha: 1
      Autocompute Value Bounds:
        Max Value: 1
        Min Value: 0
        Value: false
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Height-colored PCD Ground
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_map/static_cloud
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Static PCD Structures
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /navigation_display/static_pcd_structures
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Current Navigation Obstacles
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /navigation_display/global_lethal_obstacles
      Value: true
    - Alpha: 1
      Autocompute Value Bounds:
        Max Value: 1
        Min Value: 0
        Value: false
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0.6
      Enabled: true
      Name: Live Local Structures
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /navigation_display/local_structure_cloud
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Value Bounds:
        Max Value: 1
        Min Value: 0
        Value: false
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0.6
      Enabled: true
      Name: Live Local Ground
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 1
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /navigation_display/local_ground_cloud
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Class: grid_map_rviz_plugin/GridMap
      Color: 200; 200; 200
      Color Layer: display_relief
      Color Transformer: GridMapLayer
      Enabled: true
      Height Layer: display_elevation
      Height Transformer: GridMapLayer
      History Length: 1
      Invert Rainbow: false
      Max Color: 200; 200; 200
      Max Intensity: 1
      Min Color: 200; 200; 200
      Min Intensity: 0
      Name: Smooth Elevation Surface
      Show Grid Lines: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_map/static
      Use Rainbow: false
      Value: true
    - Alpha: 0.85
      Class: grid_map_rviz_plugin/GridMap
      Color: 255; 255; 255
      Color Layer: elevation
      Color Transformer: GridMapLayer
      Enabled: true
      Height Layer: elevation
      Height Transformer: GridMapLayer
      History Length: 1
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 10
      Min Color: 255; 255; 255
      Min Intensity: -10
      Name: Online Local Terrain
      Show Grid Lines: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fastdem/postprocess/gridmap
      Use Rainbow: false
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: false
      Name: 2D Occupancy Overlay (navigation remains active)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_updates
      Use Timestamp: false
      Value: false
    - Alpha: 0.45
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: Planning Costmap Full
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Update Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap_updates
      Use Timestamp: false
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 255; 60; 40
      Enabled: true
      Name: Planner Footprint
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/published_footprint
      Value: true
    - Alpha: 0.45
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: Raw Global Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /navigation_display/global_costmap_raw_view
      Use Timestamp: false
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 全局膨胀代价
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /navigation_display/global_inflation
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 局部膨胀代价
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /navigation_display/local_inflation
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 150; 150; 150
      Enabled: true
      Line Style: Billboards
      Line Width: 0.06
      Name: Global Reference Path
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /plan_display
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 40; 230; 90
      Enabled: true
      Line Style: Billboards
      Line Width: 0.05
      Name: Local Path
      Offset:
        X: 0
        Y: 0
        Z: 0.08
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /local_plan_display
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 36; 45
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.0685
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
    Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 22
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.8
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
  X: 50
  Y: 50
