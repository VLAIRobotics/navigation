Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Live Structure Cloud1
    - /Live Ground Cloud1
    - /History Structure Cloud1
    - /History Ground Cloud1
    - /Robot Footprint1
    - /Global Path1
    - /Local Path1
    - /Traveled Path1
    Splitter Ratio: 0.5
  Tree Height: 600
- Class: rviz_common/Tool Properties
  Name: Tool Properties
  Splitter Ratio: 0.5
- Class: rviz_common/Views
  Name: Views
  Splitter Ratio: 0.5
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
- Class: bringup/NavigationStatus
  Name: 导航诊断
Visualization Manager:
  Class: ''
  Frame Rate: 15
  Displays:
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: false
      base_link:
        Value: true
    Marker Scale: 0.5
    Name: TF
    Show Arrows: false
    Show Axes: true
    Show Names: false
    Update Interval: 0
    Value: true
  - Alpha: 1
    Axes Length: 0.8
    Axes Radius: 0.05
    Class: rviz_default_plugins/Pose
    Color: 255; 60; 60
    Enabled: true
    Head Length: 0.25
    Head Radius: 0.08
    Name: Final Goal
    Shaft Length: 0.6
    Shaft Radius: 0.04
    Shape: Arrow
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /navigation/requested_goal
    Value: true
  - Alpha: 1
    Axes Length: 0.7
    Axes Radius: 0.05
    Class: rviz_default_plugins/Pose
    Color: 50; 255; 100
    Enabled: true
    Head Length: 0.22
    Head Radius: 0.08
    Name: Current Waypoint
    Shaft Length: 0.55
    Shaft Radius: 0.04
    Shape: Arrow
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /navigation/current_waypoint
    Value: true
  - Alpha: 1
    Autocompute Value Bounds:
      Max Value: 1
      Min Value: 0
      Value: false
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0.6
    Enabled: true
    Name: Live Structure Cloud
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 3
    Size (m): 0.025
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /navigation_display/local_structure_cloud
    Use Fixed Frame: true
    Value: true
  - Alpha: 0.85
    Autocompute Value Bounds:
      Max Value: 1
      Min Value: 0
      Value: false
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Name: History Structure Cloud
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 2
    Size (m): 0.025
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /navigation_display/history_structure_cloud
    Use Fixed Frame: true
    Value: true
  - Alpha: 0.85
    Autocompute Value Bounds:
      Max Value: 1
      Min Value: 0
      Value: false
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Name: History Ground Cloud
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 1
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /navigation_display/history_ground_cloud
    Use Fixed Frame: true
    Value: true
  - Alpha: 1
    Autocompute Value Bounds:
      Max Value: 1
      Min Value: 0
      Value: false
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0.6
    Enabled: true
    Name: Live Ground Cloud
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 1
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /navigation_display/local_ground_cloud
    Use Fixed Frame: true
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/Polygon
    Color: 255; 60; 40
    Enabled: true
    Name: Robot Footprint
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/published_footprint
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 150; 150; 150
    Enabled: true
    Line Style: Billboards
    Line Width: 0.06
    Name: Global Path
    Offset:
      X: 0
      Y: 0
      Z: 0.05
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /plan_display
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 230; 190; 40
    Enabled: true
    Line Style: Billboards
    Line Width: 0.04
    Name: Traveled Path
    Offset:
      X: 0
      Y: 0
      Z: 0.03
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /navigation_display/traveled_path
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 40; 230; 90
    Enabled: true
    Line Style: Billboards
    Line Width: 0.05
    Name: Local Path
    Offset:
      X: 0
      Y: 0
      Z: 0.08
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /local_plan_display
    Value: true
  - Alpha: 0.85
    Class: grid_map_rviz_plugin/GridMap
    Color: 255; 255; 255
    Color Layer: elevation
    Color Transformer: GridMapLayer
    Enabled: false
    Height Layer: elevation
    Height Transformer: GridMapLayer
    History Length: 1
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 10
    Min Color: 255; 255; 255
    Min Intensity: -10
    Name: FastDEM GridMap (debug)
    Show Grid Lines: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fastdem/postprocess/gridmap
    Use Rainbow: false
    Value: false
  - Alpha: 0.45
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: false
    Name: Global Costmap (debug)
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap
    Update Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap_updates
    Use Timestamp: false
    Value: false
  - Alpha: 0.6499999761581421
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: false
    Name: Local Costmap (debug)
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap_updates
    Use Timestamp: false
    Value: false
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: z
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: Intensity
    Decay Time: 0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 3.654020071029663
    Min Color: 0; 0; 0
    Min Intensity: -0.22312115132808685
    Name: Raw Registered Cloud (debug)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 1
    Size (m): 0.029999999329447746
    Style: Flat Squares
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /cloud_registered_body
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  Enabled: true
  Global Options:
    Background Color: 30; 36; 45
    Fixed Frame: odom
    Frame Rate: 15
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.0685
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: nav2_rviz_plugins/GoalTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
    Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 22
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.8
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
  X: 50
  Y: 50
